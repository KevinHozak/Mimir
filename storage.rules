rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /archives/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['khozak@gmail.com'];
      allow write, delete: if false;
    }
  }
}

