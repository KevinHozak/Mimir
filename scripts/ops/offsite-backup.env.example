# Private operator configuration. Keep actual identifiers out of Git.
DATABASE_PATH=/var/lib/mimir/mimir.db
WORLD_BUNDLE_ROOT=/opt/mimir/assets/world/generated
BACKUP_DIR=/var/lib/mimir/offsite/snapshots
BACKUP_STATUS_PATH=/var/lib/mimir/offsite/status.json
BACKUP_GCS_URI=gs://EXISTING-INDEPENDENT-BUCKET/daily
BACKUP_IMPERSONATE_SERVICE_ACCOUNT=EXISTING-WRITER-SERVICE-ACCOUNT
BACKUP_FRESHNESS_MAX_AGE_MS=172800000
# Local private health endpoint; abort if the external snapshot lags its writer.
BACKUP_HEALTH_URL=http://127.0.0.1:8888/health
