[Unit]
Description=Mimir bounded hosting watchdog
Wants=network-online.target
After=network-online.target
OnFailure=mimir-online-cutoff.service

[Service]
Type=oneshot
ExecStart=/opt/node/bin/node --preserve-symlinks-main /opt/mimir-online/current/scripts/online-pilot-watchdog.mjs /etc/mimir/online-pilot.json
TimeoutStartSec=110
UMask=0077
