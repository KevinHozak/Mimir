{
  "name": "@mimir/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:state": "npm run build && node dist/state.test.js",
    "build": "tsc -p tsconfig.json",
    "test:first-glow-restart": "npm run build && node dist/first-glow-restart.test.js",
    "test:first-glow-commands": "npm run build && node dist/first-glow-commands.test.js",
    "test:first-glow-command-acceptance": "npm run build && node dist/first-glow-command-acceptance.test.js",
    "test:backup-replication": "npm run build && node dist/backup-replication.test.js",
    "dev": "tsx watch src/index.ts",
    "backup": "tsx src/backup.ts",
    "test:backup-restore": "npm run build && node dist/first-glow-backup.test.js && node dist/first-glow-assets.test.js",
    "test:ai-runtime": "npm run build && node dist/first-glow-ai-runtime.test.js",
    "test:pulse-gate": "npm run build && node dist/pulse-gate.test.js",
    "test:owner-auth": "npm run build && node dist/owner-auth.test.js && node dist/owner-auth-acceptance.test.js",
    "test:security-p4": "npm run build && node dist/security-p4.test.js",
    "test:security-p5": "npm run build && node dist/security-p5.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@mimir/engine": "0.1.0",
    "@mimir/world-data": "0.1.0",
    "fastify": "^5.12.4",
    "firebase-admin": "^14.4.0"
  }
}

