{
  "name": "mimir",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mimir/world-data && npm run build --workspace @mimir/engine && npm run build --workspace @mimir/server && npm run build --workspace @mimir/web",
    "test": "npm run test --workspace @mimir/world-data && npm run test --workspace @mimir/engine",
    "start": "node scripts/run-local.mjs",
    "start:hosted": "node scripts/start-hosted.mjs",
    "public:archive": "node scripts/export-public-archive.mjs",
    "publish:archive": "node scripts/publish-public-archive.mjs",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "test:public-archive": "node scripts/public-archive.test.mjs",
    "test:observer-bridge-auth": "node scripts/observer-bridge-auth.test.mjs",
    "test:observer-bridge-sse": "node scripts/observer-bridge-sse.test.mjs",
    "test:observer-bridge-lifecycle": "node scripts/observer-bridge-lifecycle.test.mjs",
    "world:import": "npm run build --workspace @mimir/world-data && node scripts/import-world.mjs",
    "world:validate": "npm run build --workspace @mimir/world-data && node scripts/validate-world.mjs",
    "world:test": "npm run build --workspace @mimir/world-data && node scripts/import-world.test.mjs",
    "art:bible:check": "node scripts/first-glow-art-bible.mjs check",
    "art:bible:review": "node scripts/first-glow-art-bible.mjs review",
    "art:bible:test": "node scripts/first-glow-art-bible.test.mjs",
    "art:check": "node scripts/art-production.mjs check",
    "art:inventory": "node scripts/art-production.mjs inventory",
    "art:review": "node scripts/art-review.mjs",
    "art:validate": "npm run build && node scripts/first-glow-art-validation.mjs",
    "art:validate:test": "node scripts/first-glow-art-validation.test.mjs",
    "art:test": "node scripts/art-production.test.mjs",
    "audio:check": "node scripts/first-glow-audio-contract.mjs",
    "audio:test": "node scripts/first-glow-audio-contract.test.mjs",
    "test:first-glow-season-review": "npm run build && node scripts/first-glow-season-review.test.mjs",
    "first-glow:season-review": "npm run build && node scripts/first-glow-season-review.mjs",
    "first-glow:autonomous-story-review": "npm run build && node scripts/first-glow-autonomous-story-review.mjs",
    "first-glow:transition-review": "npm run build && node scripts/first-glow-transition-review.mjs",
    "first-glow:long-story-review": "npm run build && node scripts/first-glow-long-story-review.mjs",
    "profile:first-glow": "npm run build && node scripts/profile-first-glow.mjs",
    "ai-p6:vertex-evaluation": "npm run build && node scripts/first-glow-gemini-evaluation.mjs",
    "ai-p7:hybrid-quality-review": "node scripts/first-glow-hybrid-quality-review.mjs",
    "dev:server": "npm run dev --workspace @mimir/server",
    "dev:web": "npm run dev --workspace @mimir/web",
    "ai-p8:hybrid-staging": "npm run build && node scripts/first-glow-hybrid-staging.mjs",
    "ai-p9:hybrid-pilot": "npm run build && node scripts/first-glow-hybrid-pilot.mjs",
    "ai-p9:hybrid-pilot:test": "node scripts/first-glow-hybrid-pilot.test.mjs",
    "ai-p13:pilot": "npm run build && node scripts/first-glow-ai-p13-pilot.mjs",
    "ai-p13:pilot:test": "node scripts/first-glow-ai-p13-pilot.test.mjs",
    "ai-p15:rehearsal": "npm run build && node scripts/first-glow-ai-p15-rehearsal.mjs",
    "ai-p15:rehearsal:test": "node scripts/first-glow-ai-p15-rehearsal.test.mjs",
    "ai-p16:repeatability": "npm run build && node scripts/first-glow-ai-p16-repeatability.mjs",
    "ai-p16:repeatability:test": "node scripts/first-glow-ai-p16-repeatability.test.mjs",
    "ai-p17:quality-review": "npm run build && node scripts/first-glow-ai-p17-quality-review.mjs",
    "ai-p17:quality-review:test": "node scripts/first-glow-ai-p17-quality-review.test.mjs",
    "ai-p18:cadence-review": "npm run build --workspace @mimir/world-data && npm run build --workspace @mimir/engine && node scripts/first-glow-ai-p18-cadence-review.mjs",
    "ai-p18:cadence-review:test": "node scripts/first-glow-ai-p18-cadence-review.test.mjs",
    "ai-p19:determinant-review": "npm run build --workspace @mimir/world-data && npm run build --workspace @mimir/engine && node scripts/first-glow-ai-p19-determinant-review.mjs",
    "ai-p19:determinant-review:test": "node scripts/first-glow-ai-p19-determinant-review.test.mjs",
    "rc-p4:evaluation": "npm run build && node scripts/first-glow-rc-p4-evaluation.mjs",
    "rc-p4:evaluation:test": "node scripts/first-glow-rc-p4-evaluation.test.mjs",
    "lives-p5:study": "npm run build && node scripts/first-glow-lives-p5-study.mjs",
    "lives-p5:study:test": "npm run build && node scripts/first-glow-lives-p5-study.test.mjs",
    "lives-p6:evaluation": "npm run build && node scripts/first-glow-lives-p6-evaluation.mjs",
    "lives-p6:evaluation:test": "node scripts/first-glow-lives-p6-evaluation.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}




